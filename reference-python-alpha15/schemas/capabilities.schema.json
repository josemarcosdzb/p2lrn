{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p2rln.org/schema/capabilities/0.4.0",
  "title": "P2RLN Capability Document 0.4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "p2rlnVersions",
    "roles",
    "profiles"
  ],
  "properties": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "p2rlnVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "validator",
          "reader",
          "writer",
          "importer",
          "exporter",
          "preserver",
          "player",
          "round-trip"
        ]
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "modes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "validate",
                "read",
                "write",
                "preserve",
                "deliver"
              ]
            }
          }
        }
      }
    }
  }
}
