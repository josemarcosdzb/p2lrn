{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p2rln.org/schema/native-composite/0.1",
  "title": "P2RLN Native Composite Activity 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "mode", "completion"],
  "properties": {
    "schema": {"const": "https://p2rln.org/schema/native-composite/0.1"},
    "version": {"const": "0.1"},
    "mode": {"enum": ["sequence", "free"]},
    "completion": {"enum": ["all", "any"]},
    "navigation": {"enum": ["linear", "open"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 500},
    "description": {"type": "string", "maxLength": 5000},
    "extensions": {
      "type": "object",
      "propertyNames": {"type": "string", "format": "uri"},
      "additionalProperties": true
    }
  }
}
