{
  "schema": "https://p2rln.org/schema/component-editor/0.1",
  "version": "0.1",
  "id": "https://p2rln.org/component/callout/editor/2",
  "component": {
    "id": "https://p2rln.org/component/callout",
    "componentVersion": "1",
    "dataVersion": "2"
  },
  "dataSchema": "https://p2rln.org/component/callout/schema/data/2",
  "fields": [
    {
      "path": "/heading",
      "control": "text",
      "label": {"es": "Título", "en": "Heading"},
      "placeholder": {"es": "Título opcional", "en": "Optional heading"}
    },
    {
      "path": "/body",
      "control": "textarea",
      "label": {"es": "Contenido", "en": "Body"},
      "required": true
    },
    {
      "path": "/tone",
      "control": "select",
      "label": {"es": "Tipo de aviso", "en": "Callout tone"},
      "options": [
        {"value": "info", "label": {"es": "Información", "en": "Information"}},
        {"value": "note", "label": {"es": "Nota", "en": "Note"}},
        {"value": "warning", "label": {"es": "Advertencia", "en": "Warning"}},
        {"value": "success", "label": {"es": "Correcto", "en": "Success"}}
      ]
    }
  ]
}
