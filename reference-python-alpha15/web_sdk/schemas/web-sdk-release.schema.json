{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p2rln.org/schema/web-sdk-release/1",
  "title": "P2RLN Web SDK release manifest",
  "type": "object",
  "required": ["schema", "version", "webSdkVersion", "toolkitVersion", "coreVersion", "entrypoints", "files"],
  "properties": {
    "schema": {"const": "https://p2rln.org/schema/web-sdk-release/1"},
    "version": {"const": "1"},
    "webSdkVersion": {"type": "string", "minLength": 1},
    "toolkitVersion": {"type": "string", "minLength": 1},
    "coreVersion": {"type": "string", "minLength": 1},
    "entrypoints": {
      "type": "object",
      "required": ["classic", "module", "serviceWorker"],
      "additionalProperties": false,
      "properties": {
        "classic": {"type": "string", "minLength": 1},
        "module": {"type": "string", "minLength": 1},
        "serviceWorker": {"type": "string", "minLength": 1}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256", "sri"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "sri": {"type": "string", "pattern": "^sha384-[A-Za-z0-9+/]+={0,2}$"}
        }
      }
    }
  },
  "additionalProperties": false
}
