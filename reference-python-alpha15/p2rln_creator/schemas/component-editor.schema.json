{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p2rln.org/schema/component-editor/0.1",
  "title": "P2RLN Declarative Component Editor 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "id", "component", "dataSchema", "fields"],
  "properties": {
    "schema": {"const": "https://p2rln.org/schema/component-editor/0.1"},
    "version": {"const": "0.1"},
    "id": {"type": "string", "format": "uri"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "componentVersion", "dataVersion"],
      "properties": {
        "id": {"type": "string", "format": "uri"},
        "componentVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "dataVersion": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "dataSchema": {"type": "string", "format": "uri"},
    "fields": {
      "type": "array",
      "items": {"$ref": "#/$defs/field"}
    }
  },
  "$defs": {
    "langMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 64},
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {"type": ["string", "number", "boolean"]},
        "label": {"$ref": "#/$defs/langMap"}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "control", "label"],
      "properties": {
        "path": {"type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$"},
        "control": {"enum": ["text", "textarea", "number", "checkbox", "select", "asset", "rich-text", "collection"]},
        "label": {"$ref": "#/$defs/langMap"},
        "help": {"$ref": "#/$defs/langMap"},
        "placeholder": {"$ref": "#/$defs/langMap"},
        "required": {"type": "boolean"},
        "options": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/option"}},
        "minItems": {"type": "integer", "minimum": 0},
        "maxItems": {"type": "integer", "minimum": 1},
        "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}}
      },
      "allOf": [
        {
          "if": {"properties": {"control": {"const": "select"}}, "required": ["control"]},
          "then": {"required": ["options"]}
        },
        {
          "if": {"properties": {"control": {"const": "collection"}}, "required": ["control"]},
          "then": {"required": ["fields"]},
          "else": {"not": {"required": ["fields"]}}
        },
        {
          "if": {"required": ["minItems", "maxItems"]},
          "then": {
            "properties": {
              "maxItems": {"type": "integer", "minimum": 1}
            }
          }
        }
      ]
    }
  }
}
