<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
 identifier="item-1" title="QTI 3 · Demo interactiva" adaptive="false" time-dependent="false">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response>
      <qti-value>A</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-item-body>
    <p>¿Qué planeta es conocido como el planeta rojo?</p>
    <qti-choice-interaction response-identifier="RESPONSE" max-choices="1">
      <qti-prompt>Selecciona una respuesta</qti-prompt>
      <qti-simple-choice identifier="A">Marte</qti-simple-choice>
      <qti-simple-choice identifier="B">Venus</qti-simple-choice>
      <qti-simple-choice identifier="C">Júpiter</qti-simple-choice>
    </qti-choice-interaction>
  </qti-item-body>
</qti-assessment-item>
