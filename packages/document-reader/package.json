{
  "name": "@p2lrn/document-reader",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Neutral source-document ingestion contract for P2LRN Editor",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
