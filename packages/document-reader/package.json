{
  "name": "@p2lrn/document-reader",
  "version": "0.5.0-alpha.10",
  "description": "Lightweight standalone document and learning-package reader extracted from AulaP2P for P2LRN",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "p2lrn-document-reader": "./dist/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "node ../../scripts/check-publish-ready.mjs"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "dependencies": {
    "fast-xml-parser": "^5.8.0",
    "jszip": "^3.10.1"
  },
  "peerDependencies": {
    "pdfjs-dist": "5.4.296"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josemarcosfrodo/p2lrn.git",
    "directory": "packages/document-reader"
  },
  "keywords": [
    "p2lrn",
    "reader",
    "docx",
    "pptx",
    "xlsx",
    "scorm",
    "h5p",
    "moodle",
    "ims"
  ]
}
