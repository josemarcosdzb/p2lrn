{
  "name": "@p2lrn/player",
  "version": "0.5.0-alpha.14",
  "description": "Embeddable Web Component runtime for P2LRN learning packages",
  "type": "module",
  "sideEffects": true,
  "main": "./dist/p2lrn.esm.js",
  "module": "./dist/p2lrn.esm.js",
  "browser": "./dist/p2lrn.esm.js",
  "unpkg": "./dist/p2lrn.js",
  "jsdelivr": "./dist/p2lrn.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/p2lrn.esm.js",
      "default": "./dist/p2lrn.esm.js"
    },
    "./loader": "./dist/p2lrn.js",
    "./service-worker": "./dist/p2lrn-sw.js",
    "./package.json": "./package.json",
    "./server/results": {
      "types": "./types/results-server.d.ts",
      "import": "./server/results-http.mjs",
      "default": "./server/results-http.mjs"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "import": "./server/runtime-host.mjs",
      "default": "./server/runtime-host.mjs"
    }
  },
  "bin": {
    "p2lrn-copy-sw": "./bin/p2lrn-copy-sw.mjs",
    "p2rln-copy-sw": "./bin/p2rln-copy-sw.mjs",
    "p2lrn-copy-runtime": "./bin/p2lrn-copy-runtime.mjs"
  },
  "files": [
    "dist/",
    "types/",
    "schemas/",
    "bin/",
    "README.md",
    "server/",
    "THIRD_PARTY_NOTICES.md",
    "scripts/",
    "LICENSE",
    "NOTICE.md",
    "source/"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "p2lrn",
    "learning",
    "web-component",
    "lms"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build:dist": "node ./scripts/build-dist.mjs",
    "prepack": "node ./scripts/prepare-source-snapshot.mjs && npm run build:dist",
    "prepublishOnly": "node ../../scripts/check-publish-ready.mjs",
    "postpack": "node ./scripts/prepare-source-snapshot.mjs --clean"
  },
  "peerDependencies": {
    "@p2lrn/h5p-libraries": "0.5.0-alpha.14"
  },
  "peerDependenciesMeta": {
    "@p2lrn/h5p-libraries": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josemarcosdzb/p2lrn.git",
    "directory": "packages/player"
  }
}
