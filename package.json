{
  "name": "p2lrn-monorepo",
  "private": true,
  "version": "0.5.0-alpha.1",
  "type": "module",
  "workspaces": [
    "packages/toolkit",
    "packages/player",
    "packages/document-reader",
    "apps/editor"
  ],
  "scripts": {
    "build:toolkit": "npm run build --workspace @p2lrn/toolkit",
    "test:toolkit": "npm test --workspace @p2lrn/toolkit",
    "test:player": "node --test packages/player/test/*.test.mjs",
    "editor": "npm run start --workspace @p2lrn/editor",
    "build:reader": "npm run build --workspace @p2lrn/document-reader",
    "test:reader": "npm test --workspace @p2lrn/document-reader"
  },
  "engines": {
    "node": ">=22"
  }
}
