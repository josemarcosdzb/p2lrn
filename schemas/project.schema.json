{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p2lrn.org/schema/creator-project/0.2.0",
  "title": "P2LRN Creator Project 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectVersion",
    "targetFormatVersion",
    "projectId",
    "course",
    "units",
    "resources",
    "activities",
    "objectives",
    "relations",
    "profiles"
  ],
  "properties": {
    "projectVersion": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    },
    "targetFormatVersion": {
      "const": "0.4.0"
    },
    "projectId": {
      "type": "string",
      "format": "uri"
    },
    "course": {
      "$ref": "#/$defs/course"
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objective"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "langmap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "revision",
        "title",
        "children"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "$ref": "#/$defs/langmap"
        },
        "description": {
          "$ref": "#/$defs/langmap"
        },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
          }
        },
        "children": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "role",
        "title",
        "children"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "$ref": "#/$defs/langmap"
        },
        "description": {
          "$ref": "#/$defs/langmap"
        },
        "children": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "const": "file"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "href"
          ],
          "properties": {
            "type": {
              "const": "remote"
            },
            "href": {
              "type": "string",
              "format": "uri"
            },
            "expectedDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "role",
        "source"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "format": "uri"
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "originalName": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "accessibility": {
          "type": "object"
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "representations"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "$ref": "#/$defs/langmap"
        },
        "description": {
          "$ref": "#/$defs/langmap"
        },
        "representations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/representation"
          }
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "activityType",
        "title"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "activityType": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "$ref": "#/$defs/langmap"
        },
        "description": {
          "$ref": "#/$defs/langmap"
        },
        "resource": {
          "$ref": "#/$defs/key"
        },
        "resources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "objectives": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "children": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "$ref": "#/$defs/langmap"
        },
        "description": {
          "$ref": "#/$defs/langmap"
        },
        "alignments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "predicate",
        "target"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/key"
        },
        "predicate": {
          "type": "string",
          "format": "uri"
        },
        "target": {
          "$ref": "#/$defs/key"
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "requirement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "enum": [
            "required",
            "optional"
          ]
        }
      }
    }
  }
}
