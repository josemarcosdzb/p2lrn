{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p2lrn.org/schema/multipart/1",
  "title": "P2LRN Multipart Payload Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mediaType", "size", "byteDigest", "parts"],
  "properties": {
    "version": {"const": "1"},
    "mediaType": {"type": "string", "minLength": 1},
    "size": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "byteDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["href", "size", "byteDigest"],
        "properties": {
          "href": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!//)(?!.*[?#])[A-Za-z0-9._~!$&'()+,;=@%/-]+$"
          },
          "size": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "byteDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
