{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p2lrn.org/schema/component-catalog/0.1",
  "title": "P2LRN Component Catalog 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "components"
  ],
  "properties": {
    "schema": {
      "const": "https://p2lrn.org/schema/component-catalog/0.1"
    },
    "version": {
      "const": "0.1"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "componentVersion",
          "runtimeContractVersion",
          "title",
          "authoringDataVersion",
          "dataSchemas",
          "editorSchemas"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri",
            "minLength": 3,
            "maxLength": 500
          },
          "componentVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "runtimeContractVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "title": {
            "$ref": "#/$defs/langMap"
          },
          "description": {
            "$ref": "#/$defs/langMap"
          },
          "authoringDataVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "dataSchemas": {
            "$ref": "#/$defs/versionUriMap"
          },
          "editorSchemas": {
            "$ref": "#/$defs/versionUriMap"
          }
        }
      }
    }
  },
  "$defs": {
    "langMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "versionUriMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    }
  }
}
