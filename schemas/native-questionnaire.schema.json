{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p2lrn.org/schema/native-questionnaire/0.4.0",
  "title": "P2LRN Native Questionnaire 0.4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "title",
    "grading",
    "questions"
  ],
  "properties": {
    "schema": {
      "const": "https://p2lrn.org/schema/native-questionnaire/0.4.0"
    },
    "version": {
      "const": "0.4.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "embedded-key",
            "host"
          ]
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "questionMode": {
          "enum": [
            "one-at-a-time",
            "all"
          ]
        },
        "shuffleQuestions": {
          "type": "boolean"
        },
        "showFeedback": {
          "enum": [
            "after-submit",
            "never"
          ]
        }
      }
    },
    "attemptPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "timeLimitSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "format": "uri"
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "common": {
      "type": "object",
      "required": [
        "id",
        "type",
        "prompt",
        "points"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "type": {
          "enum": [
            "single-choice",
            "multiple-choice",
            "true-false",
            "text",
            "fill-blanks",
            "ordering",
            "matching",
            "classification"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "points": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "penalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "scoring": {
          "enum": [
            "all-or-nothing",
            "partial-per-item",
            "partial-with-penalty"
          ]
        },
        "timeLimitSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "explanation": {
          "type": "string",
          "maxLength": 10000
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "choiceQuestion": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "choices"
          ],
          "properties": {
            "type": {
              "enum": [
                "single-choice",
                "multiple-choice",
                "true-false"
              ]
            },
            "choices": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "solution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "choiceIds"
              ],
              "properties": {
                "choiceIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/token"
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "textQuestion": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "solution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "acceptedAnswers"
              ],
              "properties": {
                "acceptedAnswers": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "fillQuestion": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "blanks"
          ],
          "properties": {
            "type": {
              "const": "fill-blanks"
            },
            "body": {
              "type": "string",
              "maxLength": 20000
            },
            "blanks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/token"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "options": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  }
                }
              }
            },
            "solution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "answers"
              ],
              "properties": {
                "answers": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 5000
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "orderingQuestion": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "type": {
              "const": "ordering"
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "solution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "order"
              ],
              "properties": {
                "order": {
                  "type": "array",
                  "minItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/token"
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "matchingQuestion": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "left",
            "right"
          ],
          "properties": {
            "type": {
              "const": "matching"
            },
            "left": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "right": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "solution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pairs"
              ],
              "properties": {
                "pairs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "left",
                      "right"
                    ],
                    "properties": {
                      "left": {
                        "$ref": "#/$defs/token"
                      },
                      "right": {
                        "$ref": "#/$defs/token"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "question": {
      "oneOf": [
        {
          "$ref": "#/$defs/choiceQuestion"
        },
        {
          "$ref": "#/$defs/textQuestion"
        },
        {
          "$ref": "#/$defs/fillQuestion"
        },
        {
          "$ref": "#/$defs/orderingQuestion"
        },
        {
          "$ref": "#/$defs/classificationQuestion"
        },
        {
          "$ref": "#/$defs/matchingQuestion"
        }
      ]
    },
    "classificationQuestion": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "items",
            "categories"
          ],
          "properties": {
            "type": {
              "const": "classification"
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "categories": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "solution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assignments"
              ],
              "properties": {
                "assignments": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "item",
                      "category"
                    ],
                    "properties": {
                      "item": {
                        "$ref": "#/$defs/token"
                      },
                      "category": {
                        "$ref": "#/$defs/token"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
