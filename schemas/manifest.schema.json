{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p2lrn.org/schema/manifest/0.4.0",
  "title": "P2LRN Manifest 0.4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "packageId",
    "entrypoints",
    "graph",
    "profiles",
    "files",
    "integrity"
  ],
  "properties": {
    "format": {
      "const": "P2LRN"
    },
    "formatVersion": {
      "const": "0.4.0"
    },
    "packageId": {
      "type": "string",
      "format": "uri"
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entrypoint"
      }
    },
    "graph": {
      "$ref": "#/$defs/fileDescriptorWithSchema"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profileDeclaration"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileDescriptor"
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "contentRoot"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "contentRoot": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "enum": [
            "course",
            "unit",
            "resource",
            "activity",
            "objective"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profileDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "requirement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "enum": [
            "required",
            "optional"
          ]
        }
      }
    },
    "fileDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mediaType",
        "size",
        "byteDigest",
        "contentDigest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9._~!$&'()+,;=@%/-]+$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "byteDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "fileDescriptorWithSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mediaType",
        "size",
        "byteDigest",
        "contentDigest",
        "schema"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9._~!$&'()+,;=@%/-]+$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "byteDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schema": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
