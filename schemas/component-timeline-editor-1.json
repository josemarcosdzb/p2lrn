{
  "schema": "https://p2lrn.org/schema/component-editor/0.1",
  "version": "0.1",
  "id": "https://p2lrn.org/component/timeline/editor/1",
  "component": {
    "id": "https://p2lrn.org/component/timeline",
    "componentVersion": "1",
    "dataVersion": "1"
  },
  "dataSchema": "https://p2lrn.org/component/timeline/schema/data/1",
  "fields": [
    {
      "path": "/items",
      "control": "collection",
      "label": {
        "es": "Hitos",
        "en": "Milestones"
      },
      "help": {
        "es": "Añade los hitos en el orden en que deben mostrarse.",
        "en": "Add milestones in display order."
      },
      "required": true,
      "minItems": 1,
      "maxItems": 200,
      "fields": [
        {
          "path": "/id",
          "control": "text",
          "label": {
            "es": "Identificador",
            "en": "Identifier"
          },
          "required": true
        },
        {
          "path": "/date",
          "control": "text",
          "label": {
            "es": "Fecha o periodo",
            "en": "Date or period"
          }
        },
        {
          "path": "/title",
          "control": "text",
          "label": {
            "es": "Título",
            "en": "Title"
          },
          "required": true
        },
        {
          "path": "/body",
          "control": "textarea",
          "label": {
            "es": "Descripción",
            "en": "Description"
          }
        }
      ]
    }
  ]
}
